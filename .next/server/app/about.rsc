27:T7a7,{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Where does COSBEL Ltd work?","acceptedAnswer":{"@type":"Answer","text":"We are based in Kimironko, Gasabo, Kigali and take on projects across Rwanda."}},{"@type":"Question","name":"Do you work on homes as well as factories?","acceptedAnswer":{"@type":"Answer","text":"Yes. Our core work is industrial and commercial, but we also carry out residential electrical installation and maintenance."}},{"@type":"Question","name":"Can you install a compact substation or transformer?","acceptedAnswer":{"@type":"Answer","text":"Yes. We supply and install compact substations and distribution transformers, including the high-voltage to low-voltage chain: ring main units, breakers, protection and metering."}},{"@type":"Question","name":"Can you connect a generator to our existing supply?","acceptedAnswer":{"@type":"Answer","text":"Yes. We integrate generators through automatic transfer switches and interlocked changeovers, designed so that two sources are never connected together."}},{"@type":"Question","name":"Do you manufacture ATS units?","acceptedAnswer":{"@type":"Answer","text":"We design and manufacture our own manual ATS units, including installations that manage several generators."}},{"@type":"Question","name":"Can you inspect our transformer or electrical equipment?","acceptedAnswer":{"@type":"Answer","text":"Yes. We inspect existing equipment such as transformers and deliver formal condition reports."}},{"@type":"Question","name":"Do you provide documentation when a job is finished?","acceptedAnswer":{"@type":"Answer","text":"Every project is handed over with completion certificates and inspection reports on COSBEL-branded documents."}},{"@type":"Question","name":"How do we get a quote?","acceptedAnswer":{"@type":"Answer","text":"Call +250 788 312 434, email us, or send the request form on our contact page and we will come back to you."}}]}1a:["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$27"}}]
